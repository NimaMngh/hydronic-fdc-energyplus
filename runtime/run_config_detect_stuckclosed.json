  "var_mapping": {
    "zone_temp": ["Zone Mean Air Temperature",                    "Core_Retail"],
    "htg_sp":    ["Zone Thermostat Heating Setpoint Temperature", "Core_Retail"],
    "m_dot":     ["System Node Mass Flow Rate",                   "Core_Retail HW Inlet Node"],
    "t_inlet":   ["System Node Temperature",                      "Core_Retail HW Inlet Node"],
    "t_outlet":  ["System Node Temperature",                      "Core_Retail HW Outlet Node"],
    "t_outdoor": ["Site Outdoor Air Drybulb Temperature",         "Environment"]
